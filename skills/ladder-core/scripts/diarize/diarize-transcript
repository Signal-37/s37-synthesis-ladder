#!/bin/bash
# Thin wrapper — runs the Method D pipeline in the tool's own venv.
# Usage: diarize-transcript <audio> [--model <mlx repo>] [--out draft.md] [--language en]
set -euo pipefail
# Resolve symlinks so the wrapper also works when linked onto PATH.
SRC="${BASH_SOURCE[0]}"
while [[ -L "$SRC" ]]; do
  T="$(readlink "$SRC")"
  [[ "$T" == /* ]] && SRC="$T" || SRC="$(cd "$(dirname "$SRC")" && pwd)/$T"
done
DIR="$(cd "$(dirname "$SRC")" && pwd)"
if [[ ! -x "$DIR/venv/bin/python" ]]; then
  echo "ERROR: venv missing at $DIR/venv — run $DIR/setup.sh first" >&2
  exit 1
fi
exec "$DIR/venv/bin/python" "$DIR/diarize_transcript.py" "$@"
